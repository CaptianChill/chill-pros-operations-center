rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/Users/$(request.auth.uid)).data;
    }

    function role() {
      return signedIn() && exists(/databases/$(database)/documents/Users/$(request.auth.uid))
        ? userProfile().role
        : null;
    }

    function isOwner() {
      return signedIn() && (role() == 'owner' || request.auth.token.email == 'chillprostx@gmail.com');
    }

    function isOffice() {
      return signedIn() && role() == 'office';
    }

    function isTechnician() {
      return signedIn() && role() == 'technician';
    }

    match /Users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isOwner());
      allow create, update, delete: if isOwner();
    }

    match /Customers/{customerId} {
      allow read: if signedIn();
      allow create, update: if isOwner() || isOffice() || isTechnician();
      allow delete: if isOwner() || isOffice();
    }

    match /Technicians/{technicianId} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner() || isOffice();
    }

    match /Jobs/{jobId} {
      allow read: if signedIn();
      allow create, update: if isOwner() || isOffice() || isTechnician();
      allow delete: if isOwner() || isOffice();
    }

    match /Equipment/{equipmentId} {
      allow read: if signedIn();
      allow create, update: if isOwner() || isOffice() || isTechnician();
      allow delete: if isOwner() || isOffice();
    }

    match /CarePlans/{planId} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner() || isOffice();
    }

    match /RateBook/{itemId} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // Quotes, invoices, and payments are only ever written by the
    // nativeOpsApi Cloud Function (Admin SDK, bypasses these rules) so
    // amounts and status transitions are always server-validated. Staff can
    // read them directly for a live billing view.
    match /quotes/{quoteId} {
      allow read: if isOwner() || isOffice();
      allow write: if false;
    }

    match /invoices/{invoiceId} {
      allow read: if isOwner() || isOffice();
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isOwner() || isOffice();
      allow write: if false;
    }

    match /privateIntegrations/{integrationId} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
