rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasUserProfile() {
      return signedIn() && exists(/databases/$(database)/documents/Users/$(request.auth.uid));
    }

    function userProfile() {
      return get(/databases/$(database)/documents/Users/$(request.auth.uid)).data;
    }

    function role() {
      return hasUserProfile() ? userProfile().role : null;
    }

    function technicianName() {
      return hasUserProfile() ? userProfile().technicianName : null;
    }

    function isOwner() {
      return signedIn() && role() == 'owner';
    }

    function isOffice() {
      return signedIn() && role() == 'office';
    }

    function isTechnician() {
      return signedIn()
        && role() == 'technician'
        && technicianName() is string
        && technicianName().size() > 0;
    }

    function authoritativeUserProfileIsSafe() {
      return request.resource.data.role in ['owner', 'office', 'technician']
        && (request.resource.data.role != 'technician'
          || (request.resource.data.technicianName is string
            && request.resource.data.technicianName.size() > 0
            && request.resource.data.technicianName.size() <= 200));
    }

    function assignedToCurrentTechnician(data) {
      return isTechnician()
        && data.assignedTechnician is string
        && data.assignedTechnician == technicianName();
    }

    function technicianUpdateFieldsAreSafe() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'officeStatus',
        'statusUpdatedAt',
        'completedAt',
        'findings',
        'recommendation',
        'workNotes',
        'partsUsed',
        'laborTimeNotes',
        'photoNotes',
        'photoReferences'
      ]);
    }

    function optionalTextFieldIsSafe(fieldName) {
      return !(fieldName in request.resource.data)
        || (request.resource.data[fieldName] is string
          && request.resource.data[fieldName].size() <= 20000);
    }

    function technicianWorkOrderValuesAreSafe() {
      return request.resource.data.officeStatus is string
        && optionalTextFieldIsSafe('findings')
        && optionalTextFieldIsSafe('recommendation')
        && optionalTextFieldIsSafe('workNotes')
        && optionalTextFieldIsSafe('partsUsed')
        && optionalTextFieldIsSafe('laborTimeNotes')
        && optionalTextFieldIsSafe('photoNotes')
        && (!('photoReferences' in request.resource.data)
          || (request.resource.data.photoReferences is list
            && request.resource.data.photoReferences.size() <= 50));
    }

    function technicianStatusTransitionIsSafe() {
      return request.resource.data.officeStatus == resource.data.officeStatus
        || request.resource.data.officeStatus in [
          'Dispatched',
          'In Progress',
          'Paused',
          'Waiting on Parts',
          'Ready to Invoice',
          'Completed'
        ];
    }

    function technicianStatusTimestampIsSafe() {
      return request.resource.data.officeStatus == resource.data.officeStatus
        ? request.resource.data.statusUpdatedAt == resource.data.statusUpdatedAt
        : request.resource.data.statusUpdatedAt == request.time;
    }

    function technicianCompletionStateIsSafe() {
      return request.resource.data.officeStatus == 'Completed'
        ? (resource.data.officeStatus == 'Completed'
          ? request.resource.data.completedAt == resource.data.completedAt
          : request.resource.data.completedAt == request.time)
        : !('completedAt' in request.resource.data);
    }

    function auditEventCreateIsSafe() {
      return request.resource.data.keys().hasOnly([
          'actorUid', 'actorRole', 'action', 'targetPath', 'createdAt', 'metadata'
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorRole == role()
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 100
        && request.resource.data.targetPath is string
        && request.resource.data.targetPath.size() > 0
        && request.resource.data.targetPath.size() <= 500
        && request.resource.data.createdAt == request.time
        && (!('metadata' in request.resource.data)
          || (request.resource.data.metadata is map
            && request.resource.data.metadata.size() <= 25));
    }

    match /Users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isOwner());
      allow create, update: if isOwner() && authoritativeUserProfileIsSafe();
      allow delete: if isOwner();
    }

    match /Customers/{customerId} {
      allow read: if isOwner() || isOffice() || assignedToCurrentTechnician(resource.data);
      allow create: if isOwner() || isOffice();
      allow update: if isOwner() || isOffice()
        || (assignedToCurrentTechnician(resource.data)
          && request.resource.data.assignedTechnician == resource.data.assignedTechnician
          && technicianUpdateFieldsAreSafe()
          && technicianWorkOrderValuesAreSafe()
          && technicianStatusTransitionIsSafe()
          && technicianStatusTimestampIsSafe()
          && technicianCompletionStateIsSafe());
      allow delete: if isOwner() || isOffice();
    }

    // Sensitive pricing and procurement data must live below this path instead
    // of the technician-readable customer/job document.
    match /Customers/{customerId}/Private/{privateDocumentId} {
      allow read, create, update, delete: if isOwner() || isOffice();
    }

    // Audit records are append-only. Client-created events are restricted to
    // owner/office actors and must bind identity, role, and timestamp to trusted
    // authentication/request values. Backend automation can add additional
    // events through the Admin SDK, which bypasses client security rules.
    match /AuditEvents/{eventId} {
      allow read: if isOwner() || isOffice();
      allow create: if (isOwner() || isOffice()) && auditEventCreateIsSafe();
      allow update, delete: if false;
    }

    match /Technicians/{technicianId} {
      allow read: if isOwner() || isOffice() || isTechnician();
      allow create, update, delete: if isOwner() || isOffice();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
